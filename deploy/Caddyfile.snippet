# ==== Nuvforge blocks: append to /root/Eliseenterprise.com/Caddyfile ====
# Caddy issues and renews Let's Encrypt certificates automatically once DNS points here.

nuvforge.com, www.nuvforge.com {
    root * /srv/nuvforge/site
    file_server
    encode gzip zstd

    @www host www.nuvforge.com
    redir @www https://nuvforge.com{uri} permanent

    @immutable path *.woff2 *.png *.jpg *.svg
    header @immutable Cache-Control "public, max-age=2592000, immutable"

    @code path *.css *.js
    header @code Cache-Control "public, max-age=3600, must-revalidate"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

tax.nuvforge.com {
    root * /srv/nuvforge/tax
    file_server
    encode gzip zstd

    @immutable path *.woff2 *.png *.jpg *.svg
    header @immutable Cache-Control "public, max-age=2592000, immutable"

    @code path *.css *.js
    header @code Cache-Control "public, max-age=3600, must-revalidate"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
